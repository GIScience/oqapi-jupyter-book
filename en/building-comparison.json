{"version":3,"kind":"Article","sha256":"85247c2a19391f9f11d8038bbebbdc348dbc026a3ce8cd4f2794017fa37c95d2","slug":"building-comparison","location":"/content/indicators/building_comparison.md","dependencies":[],"frontmatter":{"title":"Building Comparison","content_includes_title":false,"numbering":{"title":{"offset":2}},"thumbnail":"/oqapi-jupyter-book/en/build/gebäudevergleich_las-1bfa6b4df1a26de9c566991849bafcb2.png","exports":[{"format":"md","filename":"building_comparison.md","url":"/oqapi-jupyter-book/en/build/building_comparison-7a9767ba27a017417a951fbedf73b3b7.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"With Building Comparison, we can check the ratio of OSM building area compared with two reference\ndatasets.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CmEkj4RIyY"}],"key":"PfKuZcKDhC"},{"type":"admonition","kind":"attention","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Attention","key":"QPPWIaAnck"}],"key":"VpFCuz4YF0"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"This indicator is only available for the topic ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"WfIjCd8e20"},{"type":"emphasis","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Buildings","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Unx8br33Dr"}],"key":"ORMBYNqmzT"},{"type":"text","value":". For computation only the ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"saKqvRzAn7"},{"type":"emphasis","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"area","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"uHIbWSceFI"}],"key":"nrD8njjWvY"},{"type":"text","value":" aggregation type is used.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"suCslUakt9"}],"key":"GD8wFvvRED"}],"key":"GSgX1C7E8S"},{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Result","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"HpduudiyMs"}],"identifier":"result","label":"Result","html_id":"result","implicit":true,"key":"mCHdYYPRYy"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"You’ll find the results of the query in the result log below.\nThe green, yellow or red banner in the top left shows the attribute completeness level.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"oIFQ58rvDM"}],"key":"RKND3r94iG"},{"type":"image","url":"/oqapi-jupyter-book/en/build/gebäudevergleich_las-1bfa6b4df1a26de9c566991849bafcb2.png","key":"WnDfIRvHHA","urlSource":"../../abbildungen/gebäudevergleich_las_palmas.png"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The figure shows a bar chart with two bars for each reference dataset available in the area of\ninterest: the building area of the corresponding reference dataset within the area of interest,\nand the OSM building area, shown in grey.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"r36rkSwL2P"}],"key":"FAVhCGM7iP"},{"type":"admonition","kind":"attention","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Attention","key":"jPPGtSFY3r"}],"key":"QSjhdSjeJ5"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"If a reference dataset doesn’t cover the entire area of interest, only the OSM building area\nwithin the portion of the area of interest that the reference dataset covers is shown. This also\nmeans the reference datasets may cover different parts of the area of interest, so different OSM\nvalues may appear in the chart for each.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"xsBgwrDoOE"}],"key":"oBpXdnavHS"}],"key":"ZWxIxZ63Vo"},{"type":"heading","depth":2,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Methods and Data","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"q2HUuWKVQJ"}],"identifier":"methods-and-data","label":"Methods and Data","html_id":"methods-and-data","implicit":true,"key":"mkGUTcDd4q"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"inlineCode","value":"Extrinsic approach","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"TuLnxbvUBx"}],"key":"kFKGex4qba"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"The result is the ratio of the total building area in OSM divided by the total building area in\nthe reference dataset.\nDepending on the availability of the reference datasets in your area of interest, the result log\ngives you 1-2 comparison charts.\nBuilding Comparison is an extrinsic method, meaning OSM data is compared against external\nreference datasets.\nThis gives an indication of the completeness of the OSM data.\nHowever, the reference datasets shouldn’t be assumed to be fully correct or up to date.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"MMpMVVeWkJ"}],"key":"euFTDjbh88"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Reference datasets:","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"hLjLxGWLKv"}],"key":"CQDfbX26SG"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://docs.eubucco.com/","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"EUBUCCO","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"nz5pMJcOlz"}],"urlSource":"https://docs.eubucco.com/","key":"GQw4oJZ9PI"},{"type":"text","value":": EUBUCCO is a Europe-wide dataset of building footprints\nderived from administrative datasets. It contains over 300 million building footprints across\nEurope. This is the most complete building footprint dataset available. However, it’s older, may\nbe outdated, and only covers areas within Europe.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"GnTRO8DWwg"}],"key":"or6U6S4MwS"}],"key":"gmKEEEDU4g"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://planetarycomputer.microsoft.com/dataset/ms-buildings","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Microsoft Buildings","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"aCsBqjLJFI"}],"urlSource":"https://planetarycomputer.microsoft.com/dataset/ms-buildings","key":"CqABTRzhEq"},{"type":"text","value":": The\nMicrosoft Buildings dataset is a worldwide dataset of building footprints. A machine learning\napproach was used to derive building footprints from satellite imagery. Besides the unavoidable\nerrors that occur with machine-learning-based feature detection, this dataset’s main advantage\nis its worldwide coverage.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"vPY8zhSmJB"}],"key":"brnzUOKo4y"}],"key":"cyc8Ty3vKw"}],"key":"UKuO1V4mU4"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"In the area-of-interest selection panel in the Dashboard, you can see white, light grey and dark\ngrey regions once the Building Comparison indicator is activated. This shows the availability of\nthe reference datasets.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"Mc0OzLCbzi"}],"key":"jJF8927ff7"},{"type":"div","children":[{"type":"image","url":"/oqapi-jupyter-book/en/build/gebäudevergleich_map-2e26ef2caee81aa72d0eb99939a91e4b.png","width":500,"key":"F2WcQD9e7P","urlSource":"../../abbildungen/gebäudevergleich_map.png"}],"key":"JQvdsL0v4Q"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":58,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"In white areas, both reference datasets are available.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"jD4S0ndx1k"}],"key":"uceqPD3b3Q"}],"key":"Agb1aJydWq"},{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Light grey areas indicate that only one of the two possible reference datasets is available.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"KKgHFAmJnF"}],"key":"S6JQt3IXIj"}],"key":"vHiN4YXu7i"},{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Dark grey areas are regions without any reference dataset.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"X97NbtHRkY"}],"key":"O8eAZvxw2B"}],"key":"AhTNlV2KCK"}],"key":"SfP1nGz5rt"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"A result is only calculated if at least 50% of your selected area is covered by a reference\ndataset.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"yznjU91BwT"}],"key":"aREAp0vIdY"},{"type":"aside","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Limitations","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"zo2YRCfMjK"}],"key":"xV3GvzFe7i"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":66,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Since OpenStreetMap is continuously updated while the reference datasets were released at a\nspecific point in time, the reference datasets are no longer as current as OpenStreetMap at the\ntime of comparison.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"ILqtnbeYiC"}],"key":"FomL0Ovkhx"}],"key":"FLCJ1w8QyO"},{"type":"listItem","spread":true,"position":{"start":{"line":69,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The comparison is based only on the ratio of total areas, not on the intersection or overlap of\nindividual buildings.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"nvkf3GUnf5"}],"key":"PTDwvsxLZv"}],"key":"SsdGzqFzIM"}],"key":"X7nvfTS9ZF"}],"key":"U5ihw8T3P5"},{"type":"heading","depth":2,"position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Examples","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"fbclPNXyo5"}],"identifier":"examples","label":"Examples","html_id":"examples","implicit":true,"key":"jI1LOeYBxQ"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"The figure below shows the Building Comparison indicator for Las Palmas, where EUBUCCO covers a\nlarger part of the islands than Microsoft Buildings. Only OSM building footprints within the area\ncovered by the reference dataset are taken into account for the comparison. As a result, the total\nOSM building area appears smaller in the comparison with Microsoft Buildings than in the comparison\nwith EUBUCCO.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"LUPvi082Ql"}],"key":"yCeZfT9pnI"},{"type":"image","url":"/oqapi-jupyter-book/en/build/gebäudevergleich_las-1bfa6b4df1a26de9c566991849bafcb2.png","width":700,"key":"UBlA2CPcF3","urlSource":"../../abbildungen/gebäudevergleich_las_palmas.png"}],"key":"iuCRJxOYgh"}],"key":"tMXwl1bhS1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Attribute Completeness","url":"/attribute-completeness","group":"Completeness"},"next":{"title":"Land Cover Completeness","url":"/land-cover-completeness","group":"Completeness"}}},"domain":"http://localhost:3001"}