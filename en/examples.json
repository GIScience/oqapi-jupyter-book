,"value":"Copernicus\nEMS","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"StZcetUJ6l"}],"urlSource":"https://emergency.copernicus.eu/","key":"QEvRswOkQv"},{"type":"text","value":", it’s possible to quickly produce an initial estimate of the\nnumber of buildings or people affected.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"xn8rahrOzi"}],"key":"gUn2NKLeB6"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"After the flood in the Ahr valley in July 2021, we combined OSM buildings with flood extent data\nand census data to produce an initial situational picture for the German Red Cross.\nWe also used land use information from OSM to distinguish between residential and non-residential\nbuildings.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"IqoEDlxGjd"}],"key":"teFwGWbqbV"},{"type":"image","url":"/oqapi-jupyter-book/en/build/beispiel_ahrtal-01b79dc15bde4db7cae943e6cc4ef350.png","width":400,"key":"IlfTgN8Dcx","urlSource":"../abbildungen/beispiel_ahrtal.png"},{"type":"aside","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Completeness","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"zvX0oZKIiX"}],"key":"wjSTYV0Wgp"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"For this analysis it was important to take the completeness of the OSM data into account.\nIn the study area, the measured completeness of buildings in OSM was very high.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"cE3LXbuREK"}],"key":"G6uwYklm2U"}],"key":"WWhl3ui143"},{"type":"heading","depth":2,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Land Use","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"mrsvBYwKkf"}],"identifier":"land-use","label":"Land Use","html_id":"land-use","implicit":true,"key":"PELGdiN5im"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"For the BKG LaVerDi project, we use OSM data to better understand land use change in Germany.\nChanges in OSM can give us an early indication of where land use changes have occurred in the\n“real” world.\nThat said, OSM changes are always somewhat delayed, since it simply takes time for mappers to\nnotice a change and record it.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"F3dwAuIk1J"}],"key":"SehMjm5JEl"},{"type":"image","url":"/oqapi-jupyter-book/en/build/landcover_quality_ov-59f9049f9a0da3305c5252b5c7efc912.png","width":600,"key":"auAfiMEmMI","urlSource":"../abbildungen/landcover_quality_overview_maps.png"},{"type":"aside","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Currentness","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"FE4K5EODgh"}],"key":"lMQ07f2bIH"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"We measured several dimensions of data quality.\nAmong others, we measure currentness, which indicates how well recent land use changes are\ncaptured in OSM.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"LhYIY4qZ9l"}],"key":"lg7m9bm9EJ"}],"key":"VhUtLHM5yZ"},{"type":"heading","depth":2,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Overview Maps","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"ZF2eVcGx1q"}],"identifier":"overview-maps","label":"Overview Maps","html_id":"overview-maps","implicit":true,"key":"ZB1j3WW7wO"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Many applications use OSM as a background map or for overview maps.\nThese often rely on several relevant layers, such as the road network, water bodies and the\nlargest cities.\nFor these applications, it’s useful to quickly get a broad overview of completeness or currentness.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"U54yzGfbg4"}],"key":"SeFuIQ7qnz"},{"type":"image","url":"/oqapi-jupyter-book/en/build/hdx_country_report-7a296b81afe6594cc002a9b029a1f2ed.png","key":"hASxjwAqE0","urlSource":"../abbildungen/hdx_country_report.png"},{"type":"aside","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Road Comparison","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"iKlFAIbYd1"}],"key":"BEb9oT3sYF"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"When external road data is available, we can compare both datasets.\nFor the Road Comparison indicator, we compare OSM data and Microsoft Roads.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"GfxLx83JLz"}],"key":"jPR8eJ6wwF"}],"key":"oHo4iS1fBO"},{"type":"heading","depth":2,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Further Application Examples:","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"pTvYNloXDG"}],"identifier":"further-application-examples","label":"Further Application Examples:","html_id":"further-application-examples","implicit":true,"key":"tGEPWO3x5u"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https: