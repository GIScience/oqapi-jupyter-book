n":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"Example","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"oeU9UUryMn"}],"identifier":"example","label":"Example","html_id":"example","implicit":true,"key":"iQ017M3Ba8"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"In this example figure, agreement for the road attribute ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"B5H52fozLO"},{"type":"emphasis","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Name","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"xTyHNudJYb"}],"key":"fxi3V3NveY"},{"type":"text","value":" was checked.\nThe blue bars show the presence of the attribute in each dataset (OSM and Basis-DLM).\nThe purple bars show the agreement between the two datasets, visualising the similar and differing\nattributes in count and percentage.\nIn the selected region, the attribute ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"d5JrlOcSNt"},{"type":"emphasis","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Name","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"yDKJ1uf7ND"}],"key":"AqplCPO9cf"},{"type":"text","value":" exists in both OSM and DLM data for the most part,\nthough it appears slightly more complete in OSM. It’s also clear that the attribute shows high\nagreement between the datasets. In general, agreement doesn’t allow direct conclusions to be drawn\nabout data quality. Frequent differences in the ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"D8HjXK0U0T"},{"type":"emphasis","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"lanes","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"Sn3A6cEciW"}],"key":"CohTeT9IzQ"},{"type":"text","value":" attribute, for example, are strongly\nshaped by differing mapping conventions.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"Fsr45wCurS"}],"key":"aTPrY5QIik"},{"type":"div","children":[{"type":"image","url":"/myst_assets_folder../../abbildungen/Road_accuracy_name_HD.png","width":600,"key":"HcIUYibK0q"}],"key":"sbYkGuFbkD"},{"type":"paragraph","position":{"start":{"line":128,"column":1},"end":{"line":134,"column":1}},"children":[{"type":"text","value":"In this example figure, agreement across all attributes was checked.\nIt’s clear that for almost all roads, not all attributes are set. Some roads from OSM have all\nattributes. Since there are no roads for which all attributes are present in both datasets, the\nright-hand bar chart showing attribute agreement isn’t displayed.\nIn every federal state, at least one attribute is generally not captured, so there are few to no\nroads in the DLM with all attributes present. This selection can therefore mainly be used to check\nhow many OSM roads have all attributes.","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"MmcBO7mSrh"}],"key":"eyBipDQhEG"},{"type":"div","children":[{"type":"image","url":"/oqapi-jupyter-book/en/build/straßen_thematisch_n-14ad7322ea0be7535abfd487d37ecc75.png","width":600,"key":"PfolCYASsh","urlSource":"../../abbildungen/straßen_thematisch_nicht_in_beiden.png"}],"key":"oGRAEbdVHf"},{"type":"heading","depth":2,"position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Limitations","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"W04qHSzwVR"}],"identifier":"limitations","label":"Limitations","html_id":"limitations","implicit":true,"key":"tm5XYHygHz"},{"type":"paragra