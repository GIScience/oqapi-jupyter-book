{"version":3,"kind":"Article","sha256":"c53508237bb67220ef0380809904c097338d23bf122b498ab3520a39710557fe","slug":"user-activity","location":"/content/indicators/user_activity.md","dependencies":[],"frontmatter":{"title":"User Activity","content_includes_title":false,"numbering":{"title":{"offset":2}},"thumbnail":"/oqapi-jupyter-book/en/build/Nutzeraktivität_Heid-3a93979869e85f81431751fb31107afc.png","exports":[{"format":"md","filename":"user_activity.md","url":"/oqapi-jupyter-book/en/build/user_activity-3942538a72ca4c021660ce646f4c9b8e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"This indicator calculates how many unique users have contributed to a given topic, grouped by\nmonth.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JVRBKc3hYK"}],"key":"bVcsfiNnbJ"},{"type":"admonition","kind":"attention","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Attention","key":"i9QTF3W380"}],"key":"fQWYEgcrPk"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"This isn’t a quality indicator. No quality assessment is performed here, so no quality label is\ngiven either. The information can still be useful, although how meaningful it is depends on the\nuse case.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"AZKNIOnD0b"}],"key":"aw1YAswqKe"}],"key":"eyjki358QA"},{"type":"heading","depth":3,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Methods and Data","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"HwoYcQTP62"}],"identifier":"methods-and-data","label":"Methods and Data","html_id":"methods-and-data","implicit":true,"key":"vQwnIGrj1U"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"inlineCode","value":"Intrinsic method","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ji81DSYdpu"}],"key":"LgpWphNB7y"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The monthly number of unique users who edited a given topic within the area of interest is\ndetermined for the entire history of OSM.\nIn addition, the median for the last 3 years is calculated, and a regression line is fitted to\nshow the current trend in user activity.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"pklTrp7IKG"}],"key":"CeFndnzYbe"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"User Activity assesses the engagement of contributors within the area of interest, and doesn’t\nprovide direct information about data quality.\nCombined with other indicators, however, and by looking at absolute values and regression trends,\nit can offer insight into the sustainability of the OSM community.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"CHdpEt0SBq"}],"key":"ysuxKPgvEz"},{"type":"heading","depth":2,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Example","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"oKWFHhuHTX"}],"identifier":"example","label":"Example","html_id":"example","implicit":true,"key":"NBjQzNpUbF"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"This indicator doesn’t provide direct information about the quality of OSM data, but it can still\nhelp draw conclusions about it.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"mo6F8u0MCl"}],"key":"jqWapgvQHR"},{"type":"div","children":[{"type":"image","url":"/oqapi-jupyter-book/en/build/Nutzeraktivität_Heid-3a93979869e85f81431751fb31107afc.png","width":600,"key":"FXRlxnSltf","urlSource":"../../abbildungen/Nutzeraktivität_Heidelberg.png"}],"key":"RMskAMHXwZ"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"The chart above, showing user activity in Heidelberg for the topic ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"FTx6a8Tkvs"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Roads (cars)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"pev0oK5iPC"}],"key":"nSWlikWCY6"},{"type":"text","value":", shows for\nexample that user activity in recent years has been fairly stable at around 20, and has risen\nslightly over the last 10 years.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"H6vC0ZKpt2"}],"key":"EWlH1qUPqM"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"For a similarly sized region in the Odenwald (chart below), user activity is noticeably lower, at\nonly around 3 monthly users. Here too, this figure isn’t a clear indicator of data quality. At\nlower user numbers, however, the mapping preferences of individual users become much more relevant","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"RSLMg5plNE"}],"key":"BU8R1J6UIy"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"for example, how many semantic attributes are added.\nThis indicator c